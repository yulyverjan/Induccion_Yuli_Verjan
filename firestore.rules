rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /apprentices/{apprenticeId} {
      allow read, write: if true; // In a real app, we'd use Auth, but for this interactive prototype we allow access to the specific record
      
      match /evaluation_results/{resultId} {
        allow read, write: if true;
      }
    }
  }
}
